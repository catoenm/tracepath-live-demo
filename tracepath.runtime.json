{
  "version": 1,
  "instrumentationFiles": ["src/telemetry.mjs"],
  "operations": [
    {
      "id": "trip.plan",
      "label": "Plan itinerary",
      "service": "travel-api",
      "kind": "internal",
      "path": "src/trips.mjs",
      "symbol": "planTrip"
    },
    {
      "id": "places.load",
      "label": "Find places",
      "service": "travel-api",
      "kind": "internal",
      "path": "src/places.mjs",
      "symbol": "loadPlaces"
    },
    {
      "id": "places.cache.read",
      "label": "Read places cache",
      "service": "travel-api",
      "kind": "database",
      "path": "src/places.mjs",
      "symbol": "readCachedPlaces",
      "destination": "Redis cache"
    },
    {
      "id": "places.database.read",
      "label": "Load destination places",
      "service": "travel-api",
      "kind": "database",
      "path": "src/places.mjs",
      "symbol": "readPlacesDatabase",
      "destination": "Postgres"
    },
    {
      "id": "places.cache.write",
      "label": "Cache destination places",
      "service": "travel-api",
      "kind": "database",
      "path": "src/places.mjs",
      "symbol": "cachePlaces",
      "destination": "Redis cache"
    },
    {
      "id": "weather.fetch",
      "label": "Fetch weather",
      "service": "travel-api",
      "kind": "http",
      "path": "src/trips.mjs",
      "symbol": "fetchWeather",
      "destination": "Mock weather"
    },
    {
      "id": "weather.forecast",
      "label": "Provide forecast",
      "service": "mock-weather",
      "kind": "internal",
      "path": "src/weather.mjs",
      "symbol": "forecastWeather"
    },
    {
      "id": "route.wait",
      "label": "Enqueue route and wait",
      "service": "travel-api",
      "kind": "internal",
      "path": "src/route-queue.mjs",
      "symbol": "planRoute",
      "destination": "BullMQ / Redis"
    },
    {
      "id": "route.calculate",
      "label": "Build daily itinerary",
      "service": "route-worker",
      "kind": "internal",
      "path": "src/route-worker.mjs",
      "symbol": "calculateItinerary"
    },
    {
      "id": "trip.save",
      "label": "Save itinerary",
      "service": "travel-api",
      "kind": "database",
      "path": "src/trips.mjs",
      "symbol": "saveItinerary",
      "destination": "Postgres"
    },
    {
      "id": "api.health",
      "label": "Travel API health",
      "service": "travel-api",
      "kind": "internal",
      "path": "src/api.mjs",
      "symbol": "apiHealth"
    },
    {
      "id": "weather.health",
      "label": "Weather service health",
      "service": "mock-weather",
      "kind": "internal",
      "path": "src/weather.mjs",
      "symbol": "weatherHealth"
    }
  ],
  "entrypoints": [
    {
      "method": "POST",
      "route": "/itineraries",
      "operation": "trip.plan",
      "path": "src/api.mjs",
      "payloadKind": "json",
      "scenarioIds": ["success", "rain", "weather.failure", "planner.failure", "concurrent"]
    },
    {
      "method": "POST",
      "route": "/places",
      "operation": "places.load",
      "path": "src/api.mjs",
      "payloadKind": "json",
      "scenarioIds": ["places.lisbon", "places.kyoto", "places.reykjavik"]
    },
    {
      "method": "POST",
      "route": "/forecast",
      "operation": "weather.forecast",
      "path": "src/weather.mjs",
      "payloadKind": "json",
      "scenarioIds": [
        "forecast.sunny",
        "forecast.rain",
        "forecast.unavailable",
        "forecast.concurrent"
      ]
    },
    {
      "method": "GET",
      "route": "/health",
      "operation": "api.health",
      "path": "src/api.mjs",
      "payloadKind": "empty",
      "scenarioIds": ["api.health"]
    },
    {
      "method": "GET",
      "route": "/health",
      "operation": "weather.health",
      "path": "src/weather.mjs",
      "payloadKind": "empty",
      "scenarioIds": ["weather.health"]
    }
  ],
  "scenarios": [
    {
      "id": "success",
      "label": "Sunny Lisbon weekend",
      "description": "Cached places, weather forecast, queued planning, then a real itinerary INSERT.",
      "requests": [
        {
          "destination": "lisbon",
          "days": 2,
          "preference": "balanced",
          "weather": "sunny",
          "parallel": false
        }
      ]
    },
    {
      "id": "rain",
      "label": "Rainy Kyoto culture trip",
      "description": "The worker filters out outdoor stops and prioritizes culture.",
      "requests": [
        {
          "destination": "kyoto",
          "days": 2,
          "preference": "culture",
          "weather": "rain",
          "parallel": true
        }
      ]
    },
    {
      "id": "weather.failure",
      "label": "Weather provider unavailable",
      "description": "HTTP 502; no planning job or itinerary write.",
      "requests": [
        {
          "destination": "lisbon",
          "days": 2,
          "preference": "balanced",
          "weather": "unavailable",
          "parallel": false
        }
      ]
    },
    {
      "id": "planner.failure",
      "label": "Route worker failure",
      "description": "An explicit demo fault rejects the job; HTTP 503 and no itinerary write.",
      "requests": [
        {
          "destination": "lisbon",
          "days": 2,
          "preference": "balanced",
          "weather": "sunny",
          "parallel": false,
          "simulatePlannerFailure": true
        }
      ]
    },
    {
      "id": "concurrent",
      "label": "Three travelers at once",
      "description": "Independent destinations overlap, including one weather failure; the route worker has two slots.",
      "requests": [
        {
          "destination": "lisbon",
          "days": 2,
          "preference": "balanced",
          "weather": "sunny",
          "parallel": true
        },
        {
          "destination": "kyoto",
          "days": 2,
          "preference": "balanced",
          "weather": "unavailable",
          "parallel": true
        },
        {
          "destination": "reykjavik",
          "days": 2,
          "preference": "balanced",
          "weather": "rain",
          "parallel": true
        }
      ]
    },
    {
      "id": "places.lisbon",
      "label": "Places in Lisbon",
      "description": "Read seeded places via Redis with Postgres on a cache miss.",
      "requests": [
        {
          "destination": "lisbon"
        }
      ]
    },
    {
      "id": "places.kyoto",
      "label": "Places in Kyoto",
      "description": "Read seeded places via Redis with Postgres on a cache miss.",
      "requests": [
        {
          "destination": "kyoto"
        }
      ]
    },
    {
      "id": "places.reykjavik",
      "label": "Places in Reykjavik",
      "description": "Read seeded places via Redis with Postgres on a cache miss.",
      "requests": [
        {
          "destination": "reykjavik"
        }
      ]
    },
    {
      "id": "forecast.sunny",
      "label": "Forecast: sunny",
      "description": "Call the mock forecast service directly.",
      "requests": [
        {
          "destination": "lisbon",
          "condition": "sunny"
        }
      ]
    },
    {
      "id": "forecast.rain",
      "label": "Forecast: rain",
      "description": "Call the mock forecast service directly.",
      "requests": [
        {
          "destination": "lisbon",
          "condition": "rain"
        }
      ]
    },
    {
      "id": "forecast.unavailable",
      "label": "Forecast: unavailable",
      "description": "Call the mock forecast service directly.",
      "requests": [
        {
          "destination": "lisbon",
          "condition": "unavailable"
        }
      ]
    },
    {
      "id": "forecast.concurrent",
      "label": "Concurrent forecasts",
      "description": "Three independent forecasts; one provider failure.",
      "requests": [
        {
          "destination": "lisbon",
          "condition": "sunny"
        },
        {
          "destination": "lisbon",
          "condition": "rain"
        },
        {
          "destination": "lisbon",
          "condition": "unavailable"
        }
      ]
    },
    {
      "id": "api.health",
      "label": "Health check",
      "description": "Record a health handler without other services.",
      "requests": [{}]
    },
    {
      "id": "weather.health",
      "label": "Health check",
      "description": "Record a health handler without other services.",
      "requests": [{}]
    }
  ]
}
