{
  "name": "tracepath-live-demo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "bullmq": "5.81.5",
    "express": "5.1.0",
    "ioredis": "5.11.1",
    "pg": "8.16.3"
  },
  "description": "Instrumented API, Redis cache, BullMQ worker, mock payments, and Postgres fixture for Tracepath.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/scenarios.mjs && node scripts/timeout.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "test:timeout": "node scripts/timeout.mjs"
  }
}
